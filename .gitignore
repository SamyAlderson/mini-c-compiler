# .gitignore

# ignore build artifacts
*.pyc
__pycache__/
dist/
build/

# ignore IDE files
.idea/
.vscode/

# ignore logs
logs/

# ignore node_modules
node_modules/

# ignore coverage reports
coverage.xml
coverage.html

# ignore pip cache
pip-wheel-wheelhouse/
pip-cache/

# ignore docker images
docker-images/
docker-compose.log

# ignore git submodules
.gitmodules
.gitignore
.gitattributes